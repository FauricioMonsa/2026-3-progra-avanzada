<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quiniela</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a asp-controller="Quiniela" asp-action="Index" class="brand">QUINIELA<span>.</span></a>
        <nav>
            <a asp-controller="Quiniela" asp-action="Index">Home</a>
            <a asp-controller="Quiniela" asp-action="WebUnitTesting">Web unit testing</a>
        </nav>
    </header>
    <div class="page-shell">
        @RenderBody()
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
