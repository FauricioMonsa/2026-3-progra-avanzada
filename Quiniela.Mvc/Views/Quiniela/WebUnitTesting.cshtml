@model Quiniela.Mvc.Models.WebUnitTestingViewModel
@{
    ViewData["Title"] = "Web unit testing";
}

<main class="form-page">
    <p class="eyebrow">Web unit testing</p>
    <h1>Calculate match points</h1>
    <p class="intro">Enter the real result and the user's prediction.</p>

    <form asp-action="CalculatePoints" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <fieldset>
            <legend>Match scores</legend>
            <div class="score-grid">
                <label asp-for="RealTeamAScore"></label>
                <input asp-for="RealTeamAScore" type="number" min="0" />
                <span asp-validation-for="RealTeamAScore" class="validation-message"></span>

                <label asp-for="RealTeamBScore"></label>
                <input asp-for="RealTeamBScore" type="number" min="0" />
                <span asp-validation-for="RealTeamBScore" class="validation-message"></span>

                <label asp-for="UserTeamAScore"></label>
                <input asp-for="UserTeamAScore" type="number" min="0" />
                <span asp-validation-for="UserTeamAScore" class="validation-message"></span>

                <label asp-for="UserTeamBScore"></label>
                <input asp-for="UserTeamBScore" type="number" min="0" />
                <span asp-validation-for="UserTeamBScore" class="validation-message"></span>
            </div>
        </fieldset>
        <button class="button" type="submit">Get total points</button>
    </form>

    @if (Model.TotalPoints.HasValue)
    {
        <p class="result">Given the previous arguments, the total of points is @Model.TotalPoints.Value.</p>
    }
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
